# Обратный прокси перед приложением (ENG §2).
#
# Пока слушаем HTTP на :80 внутри контейнера — на стенде TLS не нужен.
# Для продакшена меняется первая строка на доменное имя, и Caddy сам
# получает сертификат Let's Encrypt. Отдельной конфигурации TLS не будет.

:80 {
	encode gzip

	# Метрики наружу не отдаём: их забирает Prometheus изнутри сети
	# compose. Открытый /metrics — это инвентарь устройств и адресов
	# объектов без всякой авторизации.
	handle /metrics* {
		respond "not found" 404
	}

	handle {
		reverse_proxy app:8000
	}

	log {
		output stdout
		format console
	}
}
